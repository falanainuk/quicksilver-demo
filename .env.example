NODE_ENV=production
PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-password-of-12-to-72-bytes
DATA_DIR=./data

# Configure an SMTP account or transactional email provider.
# Never use the public contact mailbox password here unless its provider explicitly supports SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Quicksilver Journeys <no-reply@example.com>"
